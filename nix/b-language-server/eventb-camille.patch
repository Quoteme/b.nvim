+        "end" to doc("end", "Ends an event, machine or context.", MACHINE),
+    )
+
+    /** Classical B keywords that ProB's summary only mentions in prose or not at all. */
+    private val classicalKeywords = buildMap {
+        val header = "$SYNTAX#Machine_header" to "ProB, Summary of B Syntax: Machine header"
+        val sections = "$SYNTAX#Machine_sections" to "ProB, Summary of B Syntax: Machine sections"
+        val inclusion = "$SYNTAX#Machine_inclusion" to "ProB, Summary of B Syntax: Machine inclusion"
+        for ((keyword, text, where) in listOf(
+            Triple("MACHINE", "Starts an abstract machine, optionally with parameters: sets if the parameter is upper-case, scalars typed in CONSTRAINTS otherwise.", header),
+            Triple("MODEL", "A synonym for MACHINE.", header),
+            Triple("SYSTEM", "A synonym for MACHINE.", header),
+            Triple("REFINEMENT", "Starts a refinement of a machine.", header),
+            Triple("IMPLEMENTATION", "Starts an implementation, the last refinement of a machine.", header),
+            Triple("EVENTS", "A synonym for OPERATIONS.", header),
+            Triple("ref", "Atelier B's keyword for event refinement.", header),
+            Triple("ABSTRACT_CONSTANTS", "Constants that need not be implemented.", sections),
+            Triple("ABSTRACT_VARIABLES", "Variables that need not be implemented.", sections),
+            Triple("VISIBLE_CONSTANTS", "A synonym for CONCRETE_CONSTANTS.", sections),
+            Triple("VISIBLE_VARIABLES", "A synonym for CONCRETE_VARIABLES.", sections),
+            Triple("LOCAL_OPERATIONS", "Operations only available inside an implementation.", sections),
