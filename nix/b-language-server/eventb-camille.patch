+    /** The structure of Event-B components in Camille notation; the handbook describes it in prose only. */
+    private val eventbKeywords = mapOf(
+        "context" to doc("context", "The static part of a model: carrier sets, constants and axioms. A context can extend other contexts and is seen by machines.", CONTEXT),
+        "extends" to doc("extends", "In a context: the contexts whose sets, constants and axioms this context includes. In an event: the abstract event whose parameters, guards and actions this event inherits.", handbook("context.html#extendind_a_context", "3.2.3.2 Extending a context")),
+        "sets" to doc("sets", "Carrier sets: new types, given by name. Each set is non-empty; enumerated sets are usually declared with `partition(S, {e1}, …, {en})`.", handbook("context.html#carrier_sets", "3.2.3.1 Carrier Sets")),
+        "constants" to doc("constants", "Constants of the context. Each constant needs an axiom from which its type can be inferred, such as `c ∈ S`.", handbook("context.html#constants_and_axioms", "3.2.3.3 Constants and axioms")),
+        "axioms" to doc("axioms", "Labelled predicates over the sets and constants that are assumed to hold. An axiom marked `theorem` must be proven from the axioms before it.", handbook("context.html#constants_and_axioms", "3.2.3.3 Constants and axioms")),
+        "theorem" to doc("theorem", "Marks an axiom, invariant or guard as a theorem: it must be proven from the predicates before it (proof obligation THM) and may then be used as a hypothesis.", POS),
+        "machine" to doc("machine", "The dynamic part of a model: variables, invariants and the events that change the variables. A machine can refine one machine and see contexts.", MACHINE),
+        "refines" to doc("refines", "In a machine: the abstract machine this machine refines. In an event: the abstract events this event refines; several events are merged.", handbook("machine.html#abstract_machine", "3.2.4.1 Refinement and Abstract machines")),
+        "sees" to doc("sees", "The contexts whose sets and constants the machine can use; their axioms are hypotheses of the machine's proof obligations.", handbook("machine.html#seeing_a_context", "3.2.4.2 Seeing a context")),
+        "variables" to doc("variables", "The state of the machine. Each variable needs an invariant from which its type can be inferred; variables of the abstract machine may be kept.", handbook("machine.html#variables_and_invariants", "3.2.4.3 Variables and invariants")),
+        "invariants" to doc("invariants", "Labelled predicates that must hold in every state: the initialisation must establish them and every event preserve them (proof obligation INV).", handbook("machine.html#variables_and_invariants", "3.2.4.3 Variables and invariants")),
+        "variant" to doc("variant", "An expression, an integer or a finite set, that every convergent event decreases and no anticipated event increases (proof obligations VAR, NAT, FIN).", TERMINATION),
