+        "any" to doc("any", "The parameters of the event. Their types must follow from the guards.", handbook("machine.html#parameters", "3.2.4.4.1 Parameters")),
+        "where" to doc("where", "The guards of the event: it can only occur when they hold. Guards may use constants, the machine's variables and the event's parameters.", handbook("machine.html#guards", "3.2.4.4.2 Guards")),
+        "when" to doc("when", "The guards of an event without parameters.", handbook("machine.html#guards", "3.2.4.4.2 Guards")),
