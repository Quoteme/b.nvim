+object Hover {
+
+    private const val HANDBOOK = "https://www3.hhu.de/stups/handbook/rodin/current/html/"
+    private const val SYNTAX = "https://prob.hhu.de/w/index.php?title=Summary_of_B_Syntax"
+
+    /** One entry of the generated documentation tables. */
+    private class Entry(val title : String, val description : String, val details : String, val link : String, val source : String, val primary : Boolean)
+
+    private fun table(name : String) : Map<String, List<Entry>> {
+        val stream = Hover::class.java.getResourceAsStream("/hover/$name.tsv") ?: return emptyMap()
+        return stream.bufferedReader(Charsets.UTF_8).readLines().mapNotNull { line ->
+            val f = line.split('\t')
+            if (f.size < 6) null else f[0] to Entry(f[1], f[2], f[3], f[4], f[5], f.getOrNull(6) == "1")
+        }.groupBy({ it.first }, { it.second })
+    }
+
+    private val eventbTable by lazy { table("eventb") }
+    private val classicalTable by lazy { table("classical") }
+
+    private class Doc(val title : String, val text : String, val link : String, val source : String)
+
+    private fun handbook(page : String, section : String) = "$HANDBOOK$page" to "Rodin Handbook, $section"
+
+    private fun doc(title : String, text : String, where : Pair<String, String>) = Doc(title, text, where.first, where.second)
+
+    private val CONTEXT = handbook("context.html", "3.2.3 Contexts")
+    private val MACHINE = handbook("machine.html", "3.2.4 Machines")
