+package b.language.server.proBMangement.prob
+
+import b.language.server.communication.CommunicatorInterface
+import com.google.inject.Guice
+import com.google.inject.Injector
+import com.google.inject.Stage
+import de.prob.animator.ReusableAnimator
+import org.eventb.core.ast.FormulaFactory
+import org.eventb.core.ast.IPosition
+import org.eventb.core.ast.Predicate
+import java.io.File
+
+/**
+ * Interactive proof of one obligation at a time, like Rodin's Proving perspective: the proof
+ * tree, the hypotheses and goal of the current node, and the tactics applying to them.
+ *
+ * It runs ProB in its own process, so that checking files while proving does not disturb it.
+ * Every change is saved to the component's .bpr file at once.
+ */
+class ProofSession(private val communicator: CommunicatorInterface) {
+
+    private val injector: Injector by lazy { Guice.createInjector(Stage.PRODUCTION, ProBKernelModule(communicator)) }
+    private val animator: ReusableAnimator by lazy { injector.getInstance(ReusableAnimator::class.java) }
+    private val factory = FormulaFactory.getDefault()
+
+    private var file: File? = null
+    private var obligations: List<ProofObligation> = emptyList()
+    private var tree: ProofTree? = null
+    private var current: ProofNode? = null
+    private var message = ""
+    private var prover: ProBProver? = null
+    private var timeout = 10000
+
+    /**
+     * Opens the obligation [name] of [file], or the first one not proved yet. [obligations] are
+     * those of the file's last check.
+     */
+    fun open(file: File, obligations: List<ProofObligation>, name: String?, timeout: Int): Map<String, Any?> {
+        if (this.file != file) closeProver()
+        this.file = file
+        this.obligations = obligations
+        this.timeout = timeout
+        message = ""
+        if (obligations.isEmpty()) {
+            tree = null
+            current = null
+            return failure("${file.name} has no proof obligations; save it, and fix its errors first")
+        }
+        val po = obligations.firstOrNull { it.name == name } ?: obligations.firstOrNull { !it.closed } ?: obligations.first()
+        if (name != null && po.name != name) message = "$name is not a proof obligation of ${file.name}"
+        val tree = ProofTree(po)
+        ProofStore(file).load()[po.name]?.let { tree.load(it) }
+        this.tree = tree
+        current = tree.root.openLeaves().firstOrNull() ?: tree.root
+        return view()
+    }
+
+    /** The name of the obligation at [line] (0-based) of [file], for following the cursor. */
+    fun at(file: File, obligations: List<ProofObligation>, line: Int): Map<String, Any?> {
+        val text = file.takeIf { it.isFile }?.readLines()?.getOrNull(line).orEmpty()
+        val labels = Regex("@([\\w'.]+)").findAll(text).map { it.groupValues[1] }.toList()
+        val candidates = obligations.filter { po ->
+            val parts = po.name.split("/")
+            labels.any { it in parts } || po.line == line + 1
+        }
+        val po = candidates.firstOrNull { !it.closed } ?: candidates.firstOrNull()
+        return mapOf("name" to po?.name)
+    }
+
+    fun close() {
+        closeProver()
+        file = null
+        tree = null
+        current = null
+        obligations = emptyList()
+    }
+
+    private fun closeProver() {
+        prover?.close()
+        prover = null
+    }
+
+    /** Runs an action of the panel; see [view] for the answer. */
+    fun perform(action: String, node: String?, tactic: String?, hyp: Int?, position: String?, input: String?): Map<String, Any?> {
+        val tree = tree ?: return failure("no proof obligation is open")
+        val target = node?.let { tree.root.find(it) } ?: current ?: tree.root
+        message = ""
+        try {
+            when (action) {
+                "view" -> {}
+                "goto" -> current = target
+                "apply" -> {
+                    val chosen = Tactics.named(tactic ?: throw TacticException("no tactic given"))
+                    val predicate = hyp?.let { i -> target.sequent.hyps.keys.elementAtOrNull(i) ?: throw TacticException("no hypothesis $i") }
+                    val at = position?.takeIf { it.isNotEmpty() }?.let { FormulaFactory.makePosition(it) } ?: IPosition.ROOT
+                    step(tree, target, chosen.make(target.sequent, Target(predicate, at), input))
+                }
+                "prob" -> prove(tree, target.openLeaves())
+                "proball" -> prove(tree, tree.root.openLeaves())
+                "review" -> step(tree, target, Tactics.review(target.sequent))
+                "prune" -> {
+                    tree.remember()
+                    target.prune()
+                    current = target
+                    changed(tree)
+                }
+                "undo", "redo" -> {
+                    val path = current?.path
+                    if (if (action == "undo") tree.undo() else tree.redo()) {
+                        current = path?.let { tree.root.find(it) } ?: tree.root.openLeaves().firstOrNull() ?: tree.root
+                        changed(tree)
+                    } else message = "nothing to $action"
+                }
+                else -> message = "unknown action $action"
+            }
+        } catch (e: TacticException) {
+            message = e.message.orEmpty()
+        }
+        return view()
+    }
+
+    /** Applies [rule] at [node], closes what it can of the new leaves and saves. */
+    private fun step(tree: ProofTree, node: ProofNode, rule: Rule) {
+        tree.remember()
+        if (!node.apply(rule)) throw TacticException("${rule.display} does not apply here")
+        postTactic(node)
+        current = node.openLeaves().firstOrNull() ?: tree.root.openLeaves().firstOrNull() ?: node
+        changed(tree)
+    }
+
+    /** Closes the open leaves below [node] that need no choice, as Rodin's post-tactic. */
+    private fun postTactic(node: ProofNode) {
+        for (leaf in node.openLeaves()) Tactics.close(leaf.sequent)?.let { leaf.apply(it) }
+    }
+
+    /** Tries to close [leaves] with ProB. */
+    private fun prove(tree: ProofTree, leaves: List<ProofNode>) {
+        val open = leaves.filter { it.isOpen }
+        if (open.isEmpty()) {
+            message = "no open goal"
+            return
+        }
+        val prover = prover ?: ProBProver(injector, animator, carrierSets(), timeout).also { prover = it }
+        val proved = mutableListOf<ProofNode>()
+        val failures = mutableListOf<String>()
+        for (leaf in open) {
+            val hyps = leaf.sequent.hyps.keys.toList()
+            when (val result = prover.solve(ProBText.negation(leaf.sequent.env, hyps, leaf.sequent.goal))) {
+                is ProBProver.Result.Proved -> proved += leaf
+                is ProBProver.Result.Counterexample -> failures += "counterexample: ${result.detail}"
+                is ProBProver.Result.Unknown -> failures += "ProB cannot decide: ${result.reason}"
+            }
+        }
+        message = when {
+            open.size == 1 -> if (proved.isNotEmpty()) "ProB proved the goal" else failures.first()
+            else -> "ProB proved ${proved.size} of ${open.size} goals" + (failures.firstOrNull()?.let { "; $it" } ?: "")
+        }
+        if (proved.isEmpty()) return
+        tree.remember()
+        proved.forEach { it.apply(Tactics.prob(it.sequent, it.sequent.hyps.keys)) }
+        current = tree.root.openLeaves().firstOrNull() ?: current
+        changed(tree)
+    }
+
+    private fun carrierSets(): List<String> {
+        val project = CamilleProject(file!!)
+        project.check()
+        return ProBProver.carrierSets(project)
+    }
+
+    /** Saves the proof and updates the obligation's status. */
+    private fun changed(tree: ProofTree) {
+        ProofStore(file!!).save(tree)
+        tree.po.updateStatus(tree)
+    }
+
+    private fun failure(text: String) = mapOf("error" to text)
+
+    /** The obligation being proved. */
+    val obligation: ProofObligation? get() = tree?.po
+
+    // ----------------------------------------------------------------------
+    // The view sent to the client
+
+    /**
+     * What the panel shows: the obligations, the proof tree, and the current node's hypotheses
+     * and goal. Each predicate lists the tactics applying to it, by character range of the text
+     * (the operator of a sub-formula, or the whole predicate), as Rodin marks operators in red.
+     */
+    fun view(): Map<String, Any?> {
+        val tree = tree ?: return failure("no proof obligation is open")
+        val node = current ?: tree.root
+        val po = tree.po
+        val origins = po.hypotheses.associate { it.predicate to it.origin }
+        return mapOf(
+            "uri" to file!!.toURI().toString(),
+            "name" to po.name,
+            "status" to po.status.name.lowercase(),
+            "detail" to po.detail,
+            "line" to po.line - 1,
+            "complete" to tree.complete,
+            "obligations" to obligations.map { mapOf("name" to it.name, "status" to it.status.name.lowercase()) },
+            "tree" to tree.root.nodes().map { n ->
+                mapOf(
+                    "path" to n.path,
+                    "depth" to n.path.count { it == '.' } + if (n.path.isEmpty()) 0 else 1,
+                    "display" to (n.rule?.display ?: n.broken?.rule?.let { "broken: ${it.display}" } ?: "…"),
+                    "open" to n.isOpen,
+                    "closed" to n.isClosed,
+                    "broken" to (n.broken != null),
+                    "current" to (n === node),
+                )
+            },
+            "node" to node.path,
+            "open" to node.isOpen,
+            "hyps" to node.sequent.hyps.entries.mapIndexed { i, (p, state) ->
+                predicate(p, false) + mapOf("id" to i, "origin" to origins[p], "state" to state.name.lowercase())
+            },
+            "goal" to predicate(node.sequent.goal, true),
+            "message" to message,
+        )
+    }
+
+    /** A predicate's text and the tactics at its operators. */
+    private fun predicate(p: Predicate, goal: Boolean): Map<String, Any?> {
+        val text = p.toString()
+        val reparsed = factory.parsePredicate(text, null).takeUnless { it.hasProblem() }?.parsedPredicate
+        val whole = mutableListOf<Map<String, Any?>>()
+        val operators = LinkedHashMap<Pair<Int, Int>, MutableList<Map<String, Any?>>>()
+        for ((tactic, position) in Tactics.applicable(p, goal)) {
+            val entry = mapOf(
+                "name" to tactic.name,
+                "label" to tactic.label,
+                "position" to position.toString(),
+                "input" to tactic.input,
+            )
+            val range = if (tactic.positional) reparsed?.let { operatorRange(text, it, position) } else null
+            if (range == null) whole += entry else {
+                operators.getOrPut(range) { mutableListOf() } += entry
+                // Rewrites are also listed for the whole predicate, with the sub-formula they rewrite.
+                whole += entry + ("label" to "${tactic.label} in ${reparsed?.getSubFormula(position)}")
+            }
+        }
+        return mapOf(
+            "text" to text,
+            "tactics" to whole,
+            "operators" to operators.map { (range, tactics) -> mapOf("start" to range.first, "end" to range.second, "tactics" to tactics) },
+        )
+    }
+
+    /** The characters of [text] showing the operator of the sub-formula at [position]: [start, end). */
+    private fun operatorRange(text: String, parsed: Predicate, position: IPosition): Pair<Int, Int>? {
+        val sub = parsed.getSubFormula(position) ?: return null
+        val location = sub.sourceLocation ?: return null
+        val children = (0 until sub.childCount).mapNotNull { sub.getChild(it).sourceLocation }
+        val (from, to) = when {
+            children.size >= 2 -> children[children.size - 2].end + 1 to children.last().start
+            children.size == 1 && children[0].start > location.start -> location.start to children[0].start
+            else -> location.start to location.end + 1
+        }
+        if (from >= to || to > text.length) return location.start to minOf(location.end + 1, text.length)
+        var start = from
+        var end = to
+        while (start < end && (text[start] == ' ' || text[start] == ')')) start++
+        while (end > start && (text[end - 1] == ' ' || text[end - 1] == '(')) end--
+        return if (start < end) start to end else from to to
+    }
+}
diff --git a/src/main/kotlin/b/language/server/proBMangement/prob/ProofStore.kt b/src/main/kotlin/b/language/server/proBMangement/prob/ProofStore.kt
new file mode 100644
index 0000000..cef8202
--- /dev/null
+++ b/src/main/kotlin/b/language/server/proBMangement/prob/ProofStore.kt
@@ -0,0 +1,373 @@
+package b.language.server.proBMangement.prob
+
+import org.eventb.core.ast.Expression
+import org.eventb.core.ast.Formula
+import org.eventb.core.ast.FormulaFactory
+import org.eventb.core.ast.FreeIdentifier
+import org.eventb.core.ast.ITypeEnvironment
+import org.eventb.core.ast.ITypeEnvironmentBuilder
+import org.eventb.core.ast.Predicate
+import org.w3c.dom.Document
+import org.w3c.dom.Element
+import java.io.File
+import javax.xml.parsers.DocumentBuilderFactory
+import javax.xml.transform.OutputKeys
+import javax.xml.transform.TransformerFactory
+import javax.xml.transform.dom.DOMSource
+import javax.xml.transform.stream.StreamResult
+
+/**
+ * The proofs of a component in Rodin's files: `<component>.bpr` holds the proof trees,
+ * `<component>.bps` the status of each obligation. The XML is Rodin's, so Rodin reuses the
+ * proofs made here once the component is imported, and proofs made in Rodin are replayed here.
+ */
+class ProofStore(private val component: File) {
+
+    private val base = component.absoluteFile.parentFile
+    private val name = component.nameWithoutExtension
+    val proofFile = File(base, "$name.bpr")
+    val statusFile = File(base, "$name.bps")
+    private val factory = FormulaFactory.getDefault()
+
+    companion object {
+        private const val CORE = "org.eventb.core"
+        private const val PR_FILE = "$CORE.prFile"
+        private const val PS_FILE = "$CORE.psFile"
+        private const val PROOF = "$CORE.prProof"
+        private const val STATUS = "$CORE.psStatus"
+        private const val RULE = "$CORE.prRule"
+        private const val ANTE = "$CORE.prAnte"
+        private const val HYP_ACTION = "$CORE.prHypAction"
+        private const val IDENT = "$CORE.prIdent"
+        private const val PRED = "$CORE.prPred"
+        private const val EXPR = "$CORE.prExpr"
+        private const val REASONER = "$CORE.prReas"
+        private const val STRING = "$CORE.prString"
+        private const val PRED_REF = "$CORE.prPredRef"
+        private const val EXPR_REF = "$CORE.prExprRef"
+
+        private const val CONFIDENCE = "$CORE.confidence"
+        private const val MANUAL = "$CORE.psManual"
+        private const val BROKEN = "$CORE.psBroken"
+        private const val GOAL = "$CORE.prGoal"
+        private const val HYPS = "$CORE.prHyps"
+        private const val UNSEL = "$CORE.prUnsel"
+        private const val HIDDEN = "$CORE.prHidden"
+        private const val INF_HYPS = "$CORE.prInfHyps"
+        private const val DISPLAY = "$CORE.prDisplay"
+        private const val REF = "$CORE.prRef"
+        private const val VALUE = "$CORE.prSValue"
+        private const val FRESH = "$CORE.prFresh"
+        private const val SETS = "$CORE.prSets"
+        private const val REASONER_ID = "$CORE.prRID"
+        private const val TYPE = "$CORE.type"
+        private const val PREDICATE = "$CORE.predicate"
+        private const val EXPRESSION = "$CORE.expression"
+    }
+
+    // ----------------------------------------------------------------------
+    // Reading
+
+    /** The saved proofs, by obligation name; proofs that cannot be read are left out. */
+    fun load(): Map<String, Skeleton> {
+        val document = read(proofFile) ?: return emptyMap()
+        val result = LinkedHashMap<String, Skeleton>()
+        for (proof in children(document.documentElement, PROOF)) {
+            try {
+                ProofReader(proof).root()?.let { result[proof.getAttribute("name")] = it }
+            } catch (e: RuntimeException) {
+                // A proof Rodin wrote with formulas we cannot read stays in the file untouched.
+            }
+        }
+        return result
+    }
+
+    private fun read(file: File): Document? {
+        if (!file.isFile) return null
+        return try {
+            DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(file)
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private fun children(element: Element, tag: String): List<Element> {
+        val result = mutableListOf<Element>()
+        var node = element.firstChild
+        while (node != null) {
+            if (node is Element && node.tagName == tag) result += node
+            node = node.nextSibling
+        }
+        return result
+    }
+
+    private fun refs(value: String): List<String> = if (value.isEmpty()) emptyList() else value.split(",")
+
+    /** Reads one prProof element: its type environment, formula pools and rule tree. */
+    private inner class ProofReader(private val proof: Element) {
+        private val env: ITypeEnvironment
+        private val reasoners = children(proof, REASONER).associate { it.getAttribute("name") to it.getAttribute(REASONER_ID) }
+        private val predicates = HashMap<String, Predicate>()
+        private val expressions = HashMap<String, Expression>()
+
+        init {
+            val builder = factory.makeTypeEnvironment()
+            refs(proof.getAttribute(SETS)).forEach { builder.addGivenSet(it) }
+            addIdents(builder, proof)
+            env = builder.makeSnapshot()
+            for (p in children(proof, PRED)) {
+                val local = env.makeBuilder().also { addIdents(it, p) }
+                predicates[p.getAttribute("name")] = parsePredicate(p.getAttribute(PREDICATE), local)
+            }
+            for (e in children(proof, EXPR)) {
+                val local = env.makeBuilder().also { addIdents(it, e) }
+                expressions[e.getAttribute("name")] = parseExpression(e.getAttribute(EXPRESSION), local)
+            }
+        }
+
+        private fun addIdents(builder: ITypeEnvironmentBuilder, element: Element) {
+            for (ident in children(element, IDENT)) builder.addName(ident.getAttribute("name"), parseType(ident.getAttribute(TYPE), builder))
+        }
+
+        private fun idents(element: Element): List<FreeIdentifier> = children(element, IDENT).map {
+            factory.makeFreeIdentifier(it.getAttribute("name"), null, parseType(it.getAttribute(TYPE), env.makeBuilder()))
+        }
+
+        private fun parseType(text: String, builder: ITypeEnvironmentBuilder) =
+            factory.parseType(text).parsedType ?: error("cannot read type $text")
+
+        private fun parsePredicate(text: String, builder: ITypeEnvironmentBuilder): Predicate {
+            val result = factory.parsePredicate(text, null)
+            check(!result.hasProblem()) { "cannot read predicate $text" }
+            val predicate = result.parsedPredicate
+            check(!predicate.typeCheck(builder).hasProblem()) { "cannot type predicate $text" }
+            return predicate
+        }
+
+        private fun parseExpression(text: String, builder: ITypeEnvironmentBuilder): Expression {
+            val result = factory.parseExpression(text, null)
+            check(!result.hasProblem()) { "cannot read expression $text" }
+            val expression = result.parsedExpression
+            check(!expression.typeCheck(builder).hasProblem()) { "cannot type expression $text" }
+            return expression
+        }
+
+        private fun predicate(ref: String) = predicates[ref] ?: error("unknown predicate $ref")
+        private fun preds(element: Element, attribute: String) =
+            if (element.hasAttribute(attribute)) refs(element.getAttribute(attribute)).map { predicate(it) } else emptyList()
+
+        fun root(): Skeleton? = children(proof, RULE).firstOrNull()?.let { skeleton(it) }
+
+        private fun skeleton(rule: Element): Skeleton {
+            val antecedents = children(rule, ANTE).sortedBy { it.getAttribute("name").toIntOrNull() ?: 0 }
+            val inputs = mutableListOf<RuleInput>()
+            for (s in children(rule, STRING)) inputs += RuleInput.Text(s.getAttribute("name").removePrefix("."), s.getAttribute(VALUE))
+            for (s in children(rule, PRED_REF)) inputs += RuleInput.Predicates(s.getAttribute("name").removePrefix("."), refs(s.getAttribute(REF)).map { predicate(it) })
+            for (s in children(rule, EXPR_REF)) {
+                inputs += RuleInput.Expressions(s.getAttribute("name").removePrefix("."), s.getAttribute(REF).split(",").map { r -> if (r.isEmpty()) null else expressions[r] })
+            }
+            val ref = rule.getAttribute("name")
+            val parsed = Rule(
+                reasoner = reasoners[ref] ?: ref,
+                display = rule.getAttribute(DISPLAY),
+                goal = if (rule.hasAttribute(GOAL)) predicate(rule.getAttribute(GOAL)) else null,
+                needed = preds(rule, HYPS).toSet(),
+                antecedents = antecedents.map { antecedent(it) },
+                confidence = rule.getAttribute(CONFIDENCE).toIntOrNull() ?: Confidence.DISCHARGED_MAX,
+                inputs = inputs,
+            )
+            return Skeleton(parsed, antecedents.map { a -> children(a, RULE).firstOrNull()?.let { skeleton(it) } ?: Skeleton(null, emptyList()) })
+        }
+
+        private fun antecedent(element: Element): Antecedent {
+            val actions = children(element, HYP_ACTION).map { a ->
+                val type = a.getAttribute("name").trimEnd { it.isDigit() }
+                when (type) {
+                    HypAction.FORWARD_INF -> HypAction.Inference(type, preds(a, HYPS), idents(a), preds(a, INF_HYPS))
+                    HypAction.REWRITE -> {
+                        val hidden = preds(a, HIDDEN)
+                        HypAction.Inference(type, preds(a, HYPS) + hidden, idents(a), preds(a, INF_HYPS), hidden)
+                    }
+                    else -> HypAction.Selection(type, preds(a, HYPS))
+                }
+            }
+            return Antecedent(
+                goal = if (element.hasAttribute(GOAL)) predicate(element.getAttribute(GOAL)) else null,
+                added = preds(element, HYPS),
+                unselected = preds(element, UNSEL),
+                idents = idents(element),
+                actions = actions,
+            )
+        }
+    }
+
+    // ----------------------------------------------------------------------
+    // Writing
+
+    /**
+     * Saves the proof of [tree]'s obligation, replacing its previous proof and keeping the others
+     * as they are; an empty proof is removed. The status file is updated likewise.
+     */
+    fun save(tree: ProofTree) {
+        val name = tree.po.name
+        val skeleton = tree.root.skeleton()
+        val document = read(proofFile) ?: newDocument(PR_FILE)
+        children(document.documentElement, PROOF).filter { it.getAttribute("name") == name }.forEach { document.documentElement.removeChild(it) }
+        if (skeleton.rule != null) document.documentElement.appendChild(ProofWriter(document, tree, skeleton).write())
+        write(document, proofFile)
+
+        val status = read(statusFile) ?: newDocument(PS_FILE)
+        children(status.documentElement, STATUS).filter { it.getAttribute("name") == name }.forEach { status.documentElement.removeChild(it) }
+        if (skeleton.rule != null) {
+            val element = status.createElement(STATUS)
+            element.setAttribute("name", name)
+            element.setAttribute(CONFIDENCE, tree.confidence.toString())
+            element.setAttribute(MANUAL, "true")
+            element.setAttribute(BROKEN, tree.root.nodes().any { it.broken != null }.toString())
+            status.documentElement.appendChild(element)
+        }
+        write(status, statusFile)
+    }
+
+    private fun newDocument(root: String): Document {
+        val document = DocumentBuilderFactory.newInstance().newDocumentBuilder().newDocument()
+        document.xmlStandalone = false
+        document.appendChild(document.createElement(root).apply { if (root == PR_FILE) setAttribute("version", "1") })
+        return document
+    }
+
+    private fun write(document: Document, file: File) {
+        val transformer = TransformerFactory.newInstance().newTransformer()
+        transformer.setOutputProperty(OutputKeys.ENCODING, "UTF-8")
+        transformer.setOutputProperty(OutputKeys.INDENT, "yes")
+        transformer.setOutputProperty(OutputKeys.STANDALONE, "no")
+        // Re-indenting a file read back would add blank lines; strip them first.
+        stripWhitespace(document.documentElement)
+        file.outputStream().use { transformer.transform(DOMSource(document), StreamResult(it)) }
+    }
+
+    private fun stripWhitespace(element: Element) {
+        var node = element.firstChild
+        while (node != null) {
+            val next = node.nextSibling
+            if (node.nodeType == org.w3c.dom.Node.TEXT_NODE && node.textContent.isBlank()) element.removeChild(node)
+            else if (node is Element) stripWhitespace(node)
+            node = next
+        }
+    }
+
+    /** Writes one prProof element, with the pools of formulas and reasoners as Rodin's ProofStoreCollector. */
+    private inner class ProofWriter(private val document: Document, private val tree: ProofTree, private val skeleton: Skeleton) {
+        private val predicates = LinkedHashMap<Predicate, String>()
+        private val expressions = LinkedHashMap<Expression, String>()
+        private val reasoners = LinkedHashMap<String, String>()
+        private val dependencies = tree.dependencies()
+        /** Identifiers in the obligation's type environment: the proof's base environment. */
+        private val poEnv = tree.po.env
+
+        private fun pred(p: Predicate) = predicates.getOrPut(p) { "p${predicates.size}" }
+        private fun expr(e: Expression) = expressions.getOrPut(e) { "e${expressions.size}" }
+        private fun preds(ps: Collection<Predicate>) = ps.joinToString(",") { pred(it) }
+
+        fun write(): Element {
+            val proof = document.createElement(PROOF)
+            proof.setAttribute("name", tree.po.name)
+            proof.setAttribute(CONFIDENCE, tree.confidence.toString())
+            proof.setAttribute(FRESH, dependencies.introduced.joinToString(","))
+            dependencies.goal?.let { proof.setAttribute(GOAL, pred(it)) }
+            proof.setAttribute(HYPS, preds(dependencies.hyps))
+            proof.setAttribute(MANUAL, "true")
+            skeleton.rule?.let { proof.appendChild(rule(it, skeleton)) }
+
+            // The base type environment: the obligation's identifiers the stored formulas mention.
+            val mentioned = LinkedHashSet<String>()
+            (predicates.keys + expressions.keys).forEach { f -> f.freeIdentifiers.forEach { mentioned += it.name } }
+            val sets = LinkedHashSet<String>()
+            val idents = mutableListOf<Pair<String, String>>()
+            val iterator = poEnv.iterator
+            while (iterator.hasNext()) {
+                iterator.advance()
+                if (iterator.name !in mentioned && !iterator.isGivenSet) continue
+                if (iterator.isGivenSet) {
+                    if (iterator.name in mentioned || typesMention(iterator.name)) sets += iterator.name
+                } else {
+                    idents += iterator.name to iterator.type.toString()
+                }
+            }
+            if (sets.isNotEmpty()) proof.setAttribute(SETS, sets.joinToString(","))
+            for ((n, type) in idents) proof.appendChild(ident(n, type))
+            for ((p, ref) in predicates) proof.appendChild(stored(PRED, PREDICATE, ref, p))
+            for ((e, ref) in expressions) proof.appendChild(stored(EXPR, EXPRESSION, ref, e))
+            for ((id, ref) in reasoners) proof.appendChild(document.createElement(REASONER).apply {
+                setAttribute("name", ref)
+                setAttribute(REASONER_ID, id)
+            })
+            return proof
+        }
+
+        /** Whether a type in the stored formulas mentions the given set [set]. */
+        private fun typesMention(set: String): Boolean = (predicates.keys + expressions.keys).any { f ->
+            f.freeIdentifiers.any { i -> i.type.toExpression().freeIdentifiers.any { it.name == set } }
+        }
+
+        private fun ident(name: String, type: String) = document.createElement(IDENT).apply {
+            setAttribute("name", name)
+            setAttribute(TYPE, type)
+        }
+
+        /** A pooled formula; identifiers introduced by the proof are declared inside it, as Rodin does. */
+        private fun stored(tag: String, attribute: String, ref: String, formula: Formula<*>) = document.createElement(tag).apply {
+            setAttribute("name", ref)
+            setAttribute(attribute, formula.toString())
+            formula.freeIdentifiers.filter { !poEnv.contains(it.name) }.forEach { appendChild(ident(it.name, it.type.toString())) }
+        }
+
+        private fun rule(rule: Rule, skeleton: Skeleton): Element {
+            val element = document.createElement(RULE)
+            element.setAttribute("name", reasoners.getOrPut(rule.reasoner) { "r${reasoners.size}" })
+            element.setAttribute(CONFIDENCE, rule.confidence.toString())
+            element.setAttribute(DISPLAY, rule.display)
+            rule.goal?.let { element.setAttribute(GOAL, pred(it)) }
+            element.setAttribute(HYPS, preds(rule.needed))
+            rule.antecedents.forEachIndexed { i, antecedent ->
+                val child = antecedent(i, antecedent)
+                skeleton.children.getOrNull(i)?.let { s -> s.rule?.let { child.appendChild(rule(it, s)) } }
+                element.appendChild(child)
+            }
+            for (input in rule.inputs) {
+                element.appendChild(when (input) {
+                    is RuleInput.Text -> document.createElement(STRING).apply { setAttribute(VALUE, input.value) }
+                    is RuleInput.Predicates -> document.createElement(PRED_REF).apply { setAttribute(REF, preds(input.values)) }
+                    is RuleInput.Expressions -> document.createElement(EXPR_REF).apply {
+                        setAttribute(REF, input.values.joinToString(",") { e -> e?.let { expr(it) } ?: "" })
+                    }
+                }.apply { setAttribute("name", "." + input.key) })
+            }
+            return element
+        }
+
+        private fun antecedent(index: Int, antecedent: Antecedent): Element {
+            val element = document.createElement(ANTE)
+            element.setAttribute("name", index.toString())
+            antecedent.goal?.let { element.setAttribute(GOAL, pred(it)) }
+            if (antecedent.added.isNotEmpty()) element.setAttribute(HYPS, preds(antecedent.added))
+            if (antecedent.unselected.isNotEmpty()) element.setAttribute(UNSEL, preds(antecedent.unselected))
+            antecedent.idents.forEach { element.appendChild(ident(it.name, it.type.toString())) }
+            antecedent.actions.forEachIndexed { i, action ->
+                element.appendChild(document.createElement(HYP_ACTION).apply {
+                    setAttribute("name", action.type + i)
+                    when (action) {
+                        is HypAction.Selection -> setAttribute(HYPS, preds(action.hyps))
+                        is HypAction.Inference -> {
+                            setAttribute(HYPS, preds(action.hyps - action.hidden.toSet()))
+                            if (action.type == HypAction.REWRITE) setAttribute(HIDDEN, preds(action.hidden))
+                            setAttribute(INF_HYPS, preds(action.inferred))
+                            action.idents.forEach { appendChild(ident(it.name, it.type.toString())) }
+                        }
+                    }
+                })
+            }
+            return element
+        }
+    }
+}
diff --git a/src/main/kotlin/b/language/server/proBMangement/prob/Proving.kt b/src/main/kotlin/b/language/server/proBMangement/prob/Proving.kt
new file mode 100644
index 0000000..9f1d4e5
--- /dev/null
+++ b/src/main/kotlin/b/language/server/proBMangement/prob/Proving.kt
@@ -0,0 +1,305 @@
+package b.language.server.proBMangement.prob
+
+import org.eventb.core.ast.Expression
+import org.eventb.core.ast.Formula
+import org.eventb.core.ast.FreeIdentifier
+import org.eventb.core.ast.ISealedTypeEnvironment
+import org.eventb.core.ast.ITypeEnvironment
+import org.eventb.core.ast.Predicate
+
+/*
+ * Interactive proofs as in Rodin's sequent prover (org.eventb.core.seqprover): a proof is a tree of
+ * rules, each turning a sequent into the sequents of its antecedents. Rules are kept in Rodin's
+ * form (reasoner, goal, needed hypotheses, antecedents), so that they are written to and read from
+ * Rodin's .bpr files, and are replayed structurally, as Rodin reuses proofs.
+ */
+
+/** Rodin's confidence levels (IConfidence). */
+object Confidence {
+    const val PENDING = 0
+    const val REVIEWED_MAX = 500
+    const val DISCHARGED_MAX = 1000
+}
+
+enum class HypState { SELECTED, VISIBLE, HIDDEN }
+
+/** A sequent: hypotheses, each selected, visible or hidden, and a goal. */
+class Sequent(val env: ISealedTypeEnvironment, val hyps: Map<Predicate, HypState>, val goal: Predicate) {
+
+    fun contains(predicate: Predicate) = predicate in hyps
+    fun containsAll(predicates: Collection<Predicate>) = predicates.all { it in hyps }
+    fun state(predicate: Predicate) = hyps[predicate]
+    val factory get() = goal.factory
+
+    companion object {
+        fun of(po: ProofObligation): Sequent {
+            val hyps = LinkedHashMap<Predicate, HypState>()
+            po.hypotheses.forEach { hyps[it.predicate] = if (it.selected) HypState.SELECTED else HypState.VISIBLE }
+            return Sequent(po.env.makeSnapshot(), hyps, po.goal)
+        }
+    }
+}
+
+/** A change to the hypotheses of an antecedent, as Rodin's IHypAction. */
+sealed class HypAction(val type: String) {
+    /** SELECT, DESELECT, HIDE or SHOW [hyps]. */
+    class Selection(type: String, val hyps: List<Predicate>) : HypAction(type)
+
+    /** FORWARD_INF: [inferred] follows from [hyps]; REWRITE: [inferred] replaces [hidden]. */
+    class Inference(type: String, val hyps: List<Predicate>, val idents: List<FreeIdentifier>,
+                    val inferred: List<Predicate>, val hidden: List<Predicate> = emptyList()) : HypAction(type)
+
+    companion object {
+        const val SELECT = "SELECT"
+        const val DESELECT = "DESELECT"
+        const val HIDE = "HIDE"
+        const val SHOW = "SHOW"
+        const val FORWARD_INF = "FORWARD_INF"
+        const val REWRITE = "REWRITE"
+    }
+}
+
+/** A sequent the rule produces: a new goal (or the old one), hypotheses and identifiers added. */
+class Antecedent(
+    val goal: Predicate?,
+    val added: List<Predicate> = emptyList(),
+    /** Added hypotheses (also in [added]) that are not selected. */
+    val unselected: List<Predicate> = emptyList(),
+    val idents: List<FreeIdentifier> = emptyList(),
+    val actions: List<HypAction> = emptyList(),
+)
+
+/** The input a reasoner stores with its rule, under a key, as Rodin's IReasonerInputWriter. */
+sealed class RuleInput(val key: String) {
+    class Text(key: String, val value: String) : RuleInput(key)
+    class Expressions(key: String, val values: List<Expression?>) : RuleInput(key)
+    class Predicates(key: String, val values: List<Predicate>) : RuleInput(key)
+}
+
+/**
+ * A rule of a proof, as Rodin's IProofRule. [reasoner] is the reasoner's id with its version,
+ * as Rodin writes it (org.eventb.core.seqprover.eq:1).
+ */
+class Rule(
+    val reasoner: String,
+    val display: String,
+    val goal: Predicate?,
+    val needed: Set<Predicate>,
+    val antecedents: List<Antecedent>,
+    val confidence: Int = Confidence.DISCHARGED_MAX,
+    val inputs: List<RuleInput> = emptyList(),
+) {
+    /** The antecedents' sequents, or null if the rule does not apply to [sequent]. */
+    fun apply(sequent: Sequent): List<Sequent>? {
+        if (!sequent.containsAll(needed)) return null
+        if (goal != null && goal != sequent.goal) return null
+        val goalInstantiation = if (goal == null) sequent.goal else null
+        return antecedents.map { generate(sequent, it, goalInstantiation) ?: return null }
+    }
+
+    private fun generate(sequent: Sequent, antecedent: Antecedent, goalInstantiation: Predicate?): Sequent? {
+        val newGoal = antecedent.goal ?: goalInstantiation ?: return null
+        val env = withIdents(sequent.env, antecedent.idents) ?: return null
+        if (!typed(env, antecedent.added + newGoal)) return null
+        if (!antecedent.added.containsAll(antecedent.unselected)) return null
+        val hyps = LinkedHashMap(sequent.hyps)
+        for (hyp in antecedent.added) {
+            hyps[hyp] = if (hyp in antecedent.unselected) {
+                if (hyps[hyp] == HypState.SELECTED) HypState.SELECTED else HypState.VISIBLE
+            } else HypState.SELECTED
+        }
+        var result = Sequent(env, hyps, newGoal)
+        for (action in antecedent.actions) result = perform(result, action)
+        return result
+    }
+
+    companion object {
+        /** [env] with the fresh identifiers [idents], or null if one is not fresh. */
+        fun withIdents(env : ISealedTypeEnvironment, idents : List<FreeIdentifier>) : ISealedTypeEnvironment? {
+            if (idents.isEmpty()) return env
+            val builder = env.makeBuilder()
+            for (ident in idents) {
+                if (builder.contains(ident.name)) return null
+                builder.add(ident)
+            }
+            return builder.makeSnapshot()
+        }
+
+        /** Whether every free identifier of [predicates] is in [env] with its type. */
+        fun typed(env : ITypeEnvironment, predicates : Collection<Predicate>) : Boolean =
+            predicates.all { p -> p.isTypeChecked && p.freeIdentifiers.all { env.getType(it.name) == it.type } }
+
+        fun perform(sequent : Sequent, action : HypAction) : Sequent {
+            val hyps = LinkedHashMap(sequent.hyps)
+            when (action) {
+                is HypAction.Selection -> {
+                    for (hyp in action.hyps) {
+                        val state = hyps[hyp] ?: continue
+                        hyps[hyp] = when (action.type) {
+                            HypAction.SELECT -> if (state == HypState.HIDDEN) state else HypState.SELECTED
+                            HypAction.DESELECT -> if (state == HypState.SELECTED) HypState.VISIBLE else state
+                            HypAction.HIDE -> HypState.HIDDEN
+                            HypAction.SHOW -> if (state == HypState.HIDDEN) HypState.VISIBLE else state
+                            else -> state
+                        }
+                    }
+                    return Sequent(sequent.env, hyps, sequent.goal)
+                }
+                is HypAction.Inference -> {
+                    // Skipped when the hypotheses are gone, as in Rodin.
+                    if (!sequent.containsAll(action.hyps)) return sequent
+                    val env = withIdents(sequent.env, action.idents) ?: return sequent
+                    if (!typed(env, action.inferred)) return sequent
+                    val select = action.hyps.isEmpty() || action.hyps.any { hyps[it] == HypState.SELECTED }
+                    val hide = !select && action.hyps.all { hyps[it] == HypState.HIDDEN }
+                    for (inferred in action.inferred) {
+                        val state = hyps[inferred]
+                        if (state == null) {
+                            hyps[inferred] = if (select) HypState.SELECTED else if (hide) HypState.HIDDEN else HypState.VISIBLE
+                        } else if (select && state != HypState.HIDDEN) {
+                            hyps[inferred] = HypState.SELECTED
+                        }
+                    }
+                    for (hidden in action.hidden) if (hidden in hyps) hyps[hidden] = HypState.HIDDEN
+                    return Sequent(env, hyps, sequent.goal)
+                }
+            }
+        }
+    }
+}
+
+/** A node of a proof tree: open while it has no rule. */
+class ProofNode(val sequent: Sequent, val parent: ProofNode? = null) {
+    var rule: Rule? = null
+        private set
+    var children: List<ProofNode> = emptyList()
+        private set
+    /** The saved proof from this node, whose first rule no longer applies. */
+    var broken: Skeleton? = null
+
+    val isOpen get() = rule == null
+
+    /** Rodin's confidence: pending if a leaf is open, reviewed if a step is reviewed. */
+    val confidence: Int get() = rule?.let { r -> (children.map { it.confidence } + r.confidence).min() } ?: Confidence.PENDING
+
+    val isClosed get() = confidence > Confidence.PENDING
+
+    /** Applies [rule] here, replacing the subtree; false if it does not apply. */
+    fun apply(rule: Rule): Boolean {
+        val sequents = rule.apply(sequent) ?: return false
+        this.rule = rule
+        broken = null
+        children = sequents.map { ProofNode(it, this) }
+        return true
+    }
+
+    fun prune() {
+        rule = null
+        broken = null
+        children = emptyList()
+    }
+
+    /** The node's place in the tree: the indices of the antecedents leading to it, as 0.1.0. */
+    val path: String get() = parent?.let { p -> (p.path.takeIf { it.isNotEmpty() }?.plus(".") ?: "") + p.children.indexOf(this) } ?: ""
+
+    fun find(path: String): ProofNode? {
+        if (path.isEmpty()) return this
+        var node: ProofNode = this
+        for (index in path.split(".")) node = node.children.getOrNull(index.toIntOrNull() ?: return null) ?: return null
+        return node
+    }
+
+    fun nodes(): List<ProofNode> = listOf(this) + children.flatMap { it.nodes() }
+
+    fun openLeaves(): List<ProofNode> = nodes().filter { it.isOpen }
+
+    /** The rules from here; a broken proof is kept as it was saved, so saving does not lose it. */
+    fun skeleton(): Skeleton = if (rule == null) broken ?: Skeleton(null, emptyList()) else Skeleton(rule, children.map { it.skeleton() })
+
+    /**
+     * Replays [skeleton] from here, as Rodin reuses a proof: each saved rule is applied to the
+     * sequent it now meets. Where a rule no longer applies, the node is left open and the saved
+     * proof from there is kept as [broken].
+     * @return whether every rule applied
+     */
+    fun replay(skeleton: Skeleton): Boolean {
+        val saved = skeleton.rule ?: return true
+        if (!apply(saved)) {
+            prune()
+            broken = skeleton
+            return false
+        }
+        var complete = true
+        children.zip(skeleton.children).forEach { (child, s) -> complete = child.replay(s) && complete }
+        return complete
+    }
+}
+
+/** The rules of a proof tree, without its sequents: what Rodin calls a proof skeleton. */
+class Skeleton(val rule: Rule?, val children: List<Skeleton>)
+
+/** A proof of an obligation: its tree, with undo and redo. */
+class ProofTree(val po: ProofObligation) {
+    var root = ProofNode(Sequent.of(po))
+        private set
+    private val undo = ArrayDeque<Skeleton>()
+    private val redo = ArrayDeque<Skeleton>()
+
+    val confidence get() = root.confidence
+    val complete get() = root.isClosed
+
+    /** Records the tree before a change, for [undo]. */
+    fun remember() {
+        undo.addLast(root.skeleton())
+        if (undo.size > 200) undo.removeFirst()
+        redo.clear()
+    }
+
+    fun undo(): Boolean = restore(undo, redo)
+    fun redo(): Boolean = restore(redo, undo)
+
+    private fun restore(from: ArrayDeque<Skeleton>, to: ArrayDeque<Skeleton>): Boolean {
+        val skeleton = from.removeLastOrNull() ?: return false
+        to.addLast(root.skeleton())
+        load(skeleton)
+        return true
+    }
+
+    /** Rebuilds the tree from [skeleton]; whether every rule applied. */
+    fun load(skeleton: Skeleton): Boolean {
+        root = ProofNode(Sequent.of(po))
+        return root.replay(skeleton)
+    }
+
+    /**
+     * What Rodin stores as the proof's dependencies: the hypotheses of the obligation and the
+     * identifiers the rules use, and those they introduce.
+     */
+    fun dependencies(): Dependencies {
+        val used = LinkedHashSet<Predicate>()
+        val introduced = LinkedHashSet<String>()
+        var goalUsed = false
+        fun visit(node: ProofNode, goalUnchanged: Boolean) {
+            val rule = node.rule ?: return
+            if (rule.goal != null && goalUnchanged) goalUsed = true
+            rule.needed.filter { it in po.hypotheses.map { h -> h.predicate } }.forEach { used += it }
+            rule.antecedents.forEach { a -> a.idents.forEach { introduced += it.name } }
+            node.children.zip(rule.antecedents).forEach { (child, a) -> visit(child, goalUnchanged && a.goal == null) }
+        }
+        visit(root, true)
+        return Dependencies(if (goalUsed) po.goal else null, used, introduced)
+    }
+
+    class Dependencies(val goal: Predicate?, val hyps: Set<Predicate>, val introduced: Set<String>)
+}
+
+/** Every position of [formula], with its sub-formula, in pre-order. */
+fun positionsOf(formula: Formula<*>): List<Pair<org.eventb.core.ast.IPosition, Formula<*>>> {
+    val result = mutableListOf<Pair<org.eventb.core.ast.IPosition, Formula<*>>>()
+    fun walk(position: org.eventb.core.ast.IPosition, sub: Formula<*>) {
+        result += position to sub
+        for (i in 0 until sub.childCount) walk(position.getChildAtIndex(i), sub.getChild(i))
+    }
+    walk(org.eventb.core.ast.IPosition.ROOT, formula)
+    return result
+}
