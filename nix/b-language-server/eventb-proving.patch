+
+    private fun selection(s: Sequent, hyp: Predicate, type: String): Rule =
+        Rule("$SEQPROVER.mngHyp", "sl/ds", null, emptySet(), listOf(Antecedent(null, actions = listOf(HypAction.Selection(type, listOf(hyp))))))
